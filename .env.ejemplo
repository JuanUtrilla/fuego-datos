# Copia este fichero a .env y rellénalo. .env no entra en git.

# AEMET OpenData: https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# NASA FIRMS: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Copernicus CDS (ERA5-Land): https://cds.climate.copernicus.eu/profile
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# SiAR (MAPA): alta en https://servicio.mapa.gob.es/siarweb/ y «Deseo darme de alta en API SiAR»
SIAR_TOKEN=
# Registros por ejecución (el token deja 10.000 al día) y cuántos para los diarios
SIAR_REGISTROS_DIA=9000
SIAR_REGISTROS_DIARIOS=3000

# Bucket privado de Cloudflare R2. Sin estas cuatro variables los datos se
# guardan en ALMACEN_LOCAL (útil para probar).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fuego-bruto
ALMACEN_LOCAL=datos_locales

# Sincronización semanal (solo en el ordenador personal). Una o varias
# carpetas separadas por ":". Si una no existe (disco desconectado), no se
# borra nada del bucket esa vez.
DESTINO_ARCHIVO=/media/usuario/disco/archivo_bruto
RETENCION_DIAS=7
